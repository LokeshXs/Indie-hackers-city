# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# wrangler: local simulated R2/KV state. Object commands default to this local store
# unless given --remote, so a mistaken upload lands a full copy of the asset here.
.wrangler

# typescript
*.tsbuildinfo
next-env.d.ts


# Blender auto-backups: rewritten on every save of the matching .blend, which is the
# real source and stays tracked.
*.blend1

# Cafe soundtracks: served from R2, never from the app bundle. One track is ~72 MB --
# larger than every other asset in this repo put together, and a binary git could never
# delta-compress. The played URL comes from NEXT_PUBLIC_CAFE_SONG_URL.
public/assets/cafes/**/songs/

# Agent skills
.agents
