# Next.js talks to LOCAL Supabase during development.
# Copy this file to `.env.local`. These local public values are safe to commit.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Google OAuth client used only by the local Supabase Auth container.
# Google Cloud authorized redirect URI:
#   http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Cafe soundtracks on R2, no trailing slash. Carries a real value rather than a blank
# one on purpose: Next.js reads .env.local ahead of .env, so an empty key here would
# shadow the configured URL and the player would call itself unconfigured. The bucket's
# custom domain, which replaced the rate-limited r2.dev host.
NEXT_PUBLIC_CAFE_SONG_URL=https://assets.indiehackers.city

# Public origin used by shared plot links and social preview metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
