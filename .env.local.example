# Next.js talks to LOCAL Supabase during development.
# Copy this file to `.env.local`. These local public values are safe to commit.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Google OAuth client used only by the local Supabase Auth container.
# Google Cloud authorized redirect URI:
#   http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Cafe soundtracks on R2, no trailing slash. Carries a real value rather than a blank
# one on purpose: Next.js reads .env.local ahead of .env, so an empty key here would
# shadow the configured URL and the player would call itself unconfigured. This r2.dev
# host is temporary -- Cloudflare rate-limits it, and a custom domain replaces it.
NEXT_PUBLIC_CAFE_SONG_URL=https://pub-3f38df21aecf4d319df6974ad0d36310.r2.dev
