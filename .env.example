# Hosted Supabase. Copy to `.env` and get these values from the Dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project ref is the ID in: https://supabase.com/dashboard/project/<project-ref>
SUPABASE_PROJECT_REF=

# Database password chosen when the hosted project was created.
# This is used only by the migration CLI and must never be NEXT_PUBLIC.
SUPABASE_DB_PASSWORD=
